# Copy to .env.local for local dev. Without a project ID the site renders the built-in
# Figma copy (src/content/defaults.ts), so it runs with no setup at all.

# Sanity project (public; safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server only. Editor-role token so the lead form can save requests into Sanity.
SANITY_WRITE_TOKEN=

# Shared secret for the Sanity publish webhook → /api/revalidate (Authorization: Bearer <secret>)
SANITY_REVALIDATE_SECRET=

# Optional. Full address incl. https://, e.g. https://redclaycrawlspace.com. On Netlify it
# defaults to the site's own address, so only set it for the real domain at launch.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only on production once the real domain points here (turns off noindex)
SITE_LIVE=
